>>SOURCE FORMAT FREE
*> binary-trees, gcobol variant (COBOL side study, GCC 15 front end). Same program as binary-trees.cob: real heap
*> nodes (a BASED group, one ALLOCATE per node, FREE per node on destroy), recursive build / check / destroy
*> programs with LOCAL-STORAGE, long-lived tree, stretch tree, the benchmark's loop structure. No arena, no pool,
*> no manual stack. Written for gcobol's rules: BINARY-LONG / BINARY-DOUBLE items, single-verb ADD / SUBTRACT /
*> MOVE, named constants, no COMPUTE / FUNCTION in the recursive programs; the child-depth argument is a static
*> WORKING-STORAGE item passed BY CONTENT, which keeps the per-instance LOCAL-STORAGE frame small (every
*> LOCAL-STORAGE item costs a libgcobol push / pop per CALL). Recursion itself stays in libgcobol: see the study.
*> The recursive CALLs go through FUNCTION-POINTER items set once in the main program (gcobol 16.2 cannot link a
*> literal-name self-CALL from a RECURSIVE program; the pointer form works on 15.2 and 16.2).
IDENTIFICATION DIVISION.
PROGRAM-ID. binary-trees-gc.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 FP-MAKE FUNCTION-POINTER EXTERNAL.
01 FP-CHECK FUNCTION-POINTER EXTERNAL.
01 FP-DESTROY FUNCTION-POINTER EXTERNAL.
01 WS-N            BINARY-LONG VALUE 10.
01 WS-ARG          PIC X(16)         VALUE SPACES.
01 K-ONE           BINARY-LONG VALUE 1.
01 K-TWO           BINARY-LONG VALUE 2.
01 K-ZERO          BINARY-LONG VALUE 0.
01 WS-MIN-DEPTH    BINARY-LONG VALUE 4.
01 WS-MIN-PLUS2    BINARY-LONG VALUE 6.
01 WS-MAX-DEPTH    BINARY-LONG.
01 WS-STRETCH      BINARY-LONG.
01 WS-DEPTH        BINARY-LONG.
01 WS-ITERATIONS   BINARY-LONG.
01 WS-SHIFT        BINARY-LONG.
01 WS-K            BINARY-LONG.
01 WS-I            BINARY-LONG.
01 WS-TOTAL        BINARY-DOUBLE VALUE 0.
01 WS-S            BINARY-DOUBLE.
01 WS-C            BINARY-DOUBLE.
01 WS-PTR          USAGE POINTER VALUE NULL.
01 WS-LONG-LIVED   USAGE POINTER VALUE NULL.
01 WS-T-PTR        USAGE POINTER VALUE NULL.
01 ED-CK           PIC -(18)9.
01 ED-N            PIC Z(8)9.
PROCEDURE DIVISION.
MAIN-PARA.
    ACCEPT WS-ARG FROM COMMAND-LINE
    IF WS-ARG NOT = SPACES
       COMPUTE WS-N = FUNCTION NUMVAL(WS-ARG)
    END-IF

    IF WS-MIN-PLUS2 > WS-N
       MOVE WS-MIN-PLUS2 TO WS-MAX-DEPTH
    ELSE
       MOVE WS-N TO WS-MAX-DEPTH
    END-IF
    ADD WS-MAX-DEPTH K-ONE GIVING WS-STRETCH

    SET FP-MAKE TO ENTRY "make"
    SET FP-CHECK TO ENTRY "check"
    SET FP-DESTROY TO ENTRY "destroy"
    CALL FP-MAKE USING WS-STRETCH WS-PTR
    CALL FP-CHECK USING WS-PTR WS-C
    ADD WS-C TO WS-TOTAL
    CALL FP-DESTROY USING WS-PTR

    *> long-lived tree (built now, checked at the end)
    SET WS-PTR TO NULL
    CALL FP-MAKE USING WS-MAX-DEPTH WS-PTR
    SET WS-LONG-LIVED TO WS-PTR

    MOVE WS-MIN-DEPTH TO WS-DEPTH
    PERFORM UNTIL WS-DEPTH > WS-MAX-DEPTH
       *> iterations = 2 ** (max - depth + min), by repeated doubling
       SUBTRACT WS-DEPTH FROM WS-MAX-DEPTH GIVING WS-SHIFT
       ADD WS-MIN-DEPTH TO WS-SHIFT
       MOVE K-ONE TO WS-ITERATIONS
       PERFORM VARYING WS-K FROM K-ZERO BY K-ONE UNTIL WS-K >= WS-SHIFT
          MULTIPLY WS-ITERATIONS BY K-TWO GIVING WS-ITERATIONS
       END-PERFORM
       MOVE 0 TO WS-S
       PERFORM VARYING WS-I FROM K-ZERO BY K-ONE UNTIL WS-I >= WS-ITERATIONS
          SET WS-T-PTR TO NULL
          CALL FP-MAKE USING WS-DEPTH WS-T-PTR
          CALL FP-CHECK USING WS-T-PTR WS-C
          ADD WS-C TO WS-S
          CALL FP-DESTROY USING WS-T-PTR
       END-PERFORM
       ADD WS-S TO WS-TOTAL
       ADD K-TWO TO WS-DEPTH
    END-PERFORM

    CALL FP-CHECK USING WS-LONG-LIVED WS-C
    ADD WS-C TO WS-TOTAL
    CALL FP-DESTROY USING WS-LONG-LIVED

    MOVE WS-TOTAL TO ED-CK
    MOVE WS-N     TO ED-N
    DISPLAY FUNCTION TRIM(ED-CK)
    DISPLAY "binary-trees(" FUNCTION TRIM(ED-N) ")"
    STOP RUN.
END PROGRAM binary-trees-gc.

*> --- recursive node allocation ---
IDENTIFICATION DIVISION.
PROGRAM-ID. make IS RECURSIVE.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 FP-MAKE FUNCTION-POINTER EXTERNAL.
01 FP-CHECK FUNCTION-POINTER EXTERNAL.
01 FP-DESTROY FUNCTION-POINTER EXTERNAL.
01 K-ONE           BINARY-LONG VALUE 1.
01 K-ZERO          BINARY-LONG VALUE 0.
01 WS-CHILD-DEPTH  BINARY-LONG.
01 NODE BASED.
   05 NODE-LEFT   USAGE POINTER.
   05 NODE-RIGHT  USAGE POINTER.
LOCAL-STORAGE SECTION.
01 LS-NEW-PTR     USAGE POINTER.
LINKAGE SECTION.
01 LK-DEPTH       BINARY-LONG.
01 LK-RESULT      USAGE POINTER.
PROCEDURE DIVISION USING LK-DEPTH LK-RESULT.
MAKE-PARA.
    ALLOCATE NODE RETURNING LS-NEW-PTR
    SET ADDRESS OF NODE TO LS-NEW-PTR
    IF LK-DEPTH = K-ZERO
       SET NODE-LEFT  TO NULL
       SET NODE-RIGHT TO NULL
    ELSE
       MOVE LK-DEPTH TO WS-CHILD-DEPTH
       SUBTRACT K-ONE FROM WS-CHILD-DEPTH
       CALL FP-MAKE USING BY CONTENT WS-CHILD-DEPTH BY REFERENCE NODE-LEFT
       *> re-anchor NODE after the recursive call rebinds the BASED address
       SET ADDRESS OF NODE TO LS-NEW-PTR
       MOVE LK-DEPTH TO WS-CHILD-DEPTH
       SUBTRACT K-ONE FROM WS-CHILD-DEPTH
       CALL FP-MAKE USING BY CONTENT WS-CHILD-DEPTH BY REFERENCE NODE-RIGHT
       SET ADDRESS OF NODE TO LS-NEW-PTR
    END-IF
    SET LK-RESULT TO LS-NEW-PTR
    EXIT PROGRAM.
END PROGRAM make.

*> --- recursive node count ---
IDENTIFICATION DIVISION.
PROGRAM-ID. check IS RECURSIVE.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 FP-MAKE FUNCTION-POINTER EXTERNAL.
01 FP-CHECK FUNCTION-POINTER EXTERNAL.
01 FP-DESTROY FUNCTION-POINTER EXTERNAL.
01 K-ONE           BINARY-DOUBLE VALUE 1.
01 NODE BASED.
   05 NODE-LEFT   USAGE POINTER.
   05 NODE-RIGHT  USAGE POINTER.
LOCAL-STORAGE SECTION.
01 LS-LEFT-PTR    USAGE POINTER.
01 LS-RIGHT-PTR   USAGE POINTER.
01 LS-CL          BINARY-DOUBLE.
01 LS-CR          BINARY-DOUBLE.
LINKAGE SECTION.
01 LK-PTR         USAGE POINTER.
01 LK-RESULT      BINARY-DOUBLE.
PROCEDURE DIVISION USING LK-PTR LK-RESULT.
CHECK-PARA.
    SET ADDRESS OF NODE TO LK-PTR
    IF NODE-LEFT = NULL
       MOVE K-ONE TO LK-RESULT
    ELSE
       SET LS-LEFT-PTR  TO NODE-LEFT
       SET LS-RIGHT-PTR TO NODE-RIGHT
       CALL FP-CHECK USING LS-LEFT-PTR  LS-CL
       CALL FP-CHECK USING LS-RIGHT-PTR LS-CR
       ADD LS-CL LS-CR GIVING LK-RESULT
       ADD K-ONE TO LK-RESULT
    END-IF
    EXIT PROGRAM.
END PROGRAM check.

*> --- recursive free ---
IDENTIFICATION DIVISION.
PROGRAM-ID. destroy IS RECURSIVE.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 FP-MAKE FUNCTION-POINTER EXTERNAL.
01 FP-CHECK FUNCTION-POINTER EXTERNAL.
01 FP-DESTROY FUNCTION-POINTER EXTERNAL.
01 NODE BASED.
   05 NODE-LEFT   USAGE POINTER.
   05 NODE-RIGHT  USAGE POINTER.
LOCAL-STORAGE SECTION.
01 LS-LEFT-PTR    USAGE POINTER.
01 LS-RIGHT-PTR   USAGE POINTER.
01 LS-SELF        USAGE POINTER.
LINKAGE SECTION.
01 LK-PTR         USAGE POINTER.
PROCEDURE DIVISION USING LK-PTR.
DESTROY-PARA.
    SET LS-SELF TO LK-PTR
    SET ADDRESS OF NODE TO LK-PTR
    IF NODE-LEFT NOT = NULL
       SET LS-LEFT-PTR  TO NODE-LEFT
       SET LS-RIGHT-PTR TO NODE-RIGHT
       CALL FP-DESTROY USING LS-LEFT-PTR
       CALL FP-DESTROY USING LS-RIGHT-PTR
    END-IF
    SET ADDRESS OF NODE TO LS-SELF
    FREE NODE
    EXIT PROGRAM.
END PROGRAM destroy.
