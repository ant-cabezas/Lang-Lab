  },
  "nativeKind": "native",
  "wasmImage": "lang-lab-wasm:go",
  "wasmtimeRun": "/usr/local/bin/wasmtime run -C cache=n --allow-precompiled --dir /app::/app /app/wasm/{b}.cwasm",
  "nodeRun": "/usr/local/bin/node --predictable --single-threaded --single-threaded-gc --no-liftoff /opt/wasm/run-node.mjs /app/wasm/{b}.wasm",
  "wasmKind": "native",
  "wasmEnv": {
   "TOKIO_WORKER_THREADS": "1"
  },
  "versions": {
   "go": "1.24.4",
