  "nodeRun": "/usr/local/bin/node --predictable --single-threaded --single-threaded-gc --no-liftoff /opt/wasm/run-node.mjs --env PYTHONHASHSEED=0 /app/py-wasm/bin/python3.13.wasm /app/{b}.py",
  "wasmKind": "interp",
