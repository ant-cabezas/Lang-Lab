   },
   "shimDoesNotCompile": [
    "fannkuch",
    "k-nucleotide"
   ],
   "checkedMultiply": {
    "finding": "Swift's overflow-checked 64-bit multiply lowers on wasm32 to a call to __multi3 (a straight-line helper of about 130 wasm instructions; aarch64 uses mul + smulh/umulh) followed by a high-word overflow test. The hot loop of bigint, gemm, k-means and viterbi calls it (once per innermost iteration in bigint and gemm, about 1.3 per innermost iteration in k-means, about 73 per timestep in viterbi).",
    "how": "diagnostic only, outside the benchmark sources: scratch copies with wrapping &* on the hot multiplies (k-means and viterbi also wrap the adjacent index additions), built with the same swiftc 6.2.0 flags and the int64 shim; checksums identical; qemu insn differentials, wasmtime 50",
    "wasmtimeOverNativeShipped": {
     "bigint": 11.14,
     "gemm": 8.94,
     "k-means": 8.77,
     "viterbi": 7.57
    },
    "wasmtimeOverNativeWrapping": {
     "bigint": 1.4,
     "gemm": 2.46,
     "k-means": 1.86,
     "viterbi": 1.85
    },
    "shareOfExtraInstructionsRemoved": {
     "bigint": 0.99,
     "gemm": 0.86,
     "k-means": 0.93,
     "viterbi": 0.91
    },
    "instructionsPerCall": "about 131 to 138 (bigint exact: 5,550,104 calls in the differential, 727.1M instructions)",
    "shimRole": "in gemm, k-means and viterbi the 64-bit multiplies come from the Int64 shim (native Int is 64-bit, so the work matches native); unshimmed 32-bit builds have no __multi3 call but are wrong on wasm32. bigint uses UInt64 explicitly and is unshimmed"
   }
  },
  "columnRoles": {
   "native": "control",
   "wasmtime": "wasm",
   "node": "wasm",
   "native-shim": "reference"
  }
